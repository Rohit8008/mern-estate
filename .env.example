# Root .env — used by docker-compose for frontend build args.
# These get baked into the frontend bundle at docker build time, so they are
# public values, not secrets. Use an UNSIGNED Cloudinary upload preset.
#
# Firebase was removed from this product; there is no `firebase` dependency in
# either package.json. Uploads go to Cloudinary via frontend/src/utils/cloudinary.js.

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
