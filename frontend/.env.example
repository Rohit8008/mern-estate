# ===========================================
# MERN Estate Client - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit your .env.local file to version control
#
# Note: All client-side variables must be prefixed with VITE_

# ---- API Configuration ----
# Leave empty in development (uses Vite proxy)
# Set to your API URL in production
VITE_API_URL=

# ---- Socket.io Configuration ----
# Leave empty in development (defaults to localhost:3000)
# Leave empty in production (uses same origin)
# Set explicitly if your API is on a different domain
VITE_SOCKET_URL=

# ---- Uploads (Cloudinary) ----
# Images and voice notes are uploaded client-side straight to Cloudinary, so
# both of these are baked into the bundle at build time and are NOT secrets.
# Use an UNSIGNED upload preset restricted to the folders this app writes.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- API response decryption ----
# Must match API_RESPONSE_SECRET on the backend when ENCRYPT_API_RESPONSES is
# on. Leave both empty to send responses in the clear.
VITE_API_RESPONSE_SECRET=

# ---- Error Tracking (Sentry) ----
# Sign up at https://sentry.io and get your DSN
# This is safe to include in client-side code
VITE_SENTRY_DSN=

# ---- Feature Flags ----
# Enable development dashboard (shows performance metrics)
VITE_ENABLE_DEV_DASHBOARD=false
