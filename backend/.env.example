# ===========================================
# Real Vista API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
#
# Every variable here is read by the backend (config/environment.js or the file
# named beside it). Values shown equal the code defaults unless noted.
#
# REQUIRED at boot (the process exits without them): NODE_ENV, MONGO_URI,
# JWT_SECRET, REFRESH_SECRET, MESSAGE_ENCRYPTION_KEY. In production it also
# needs APP_DOMAIN or DEFAULT_TENANT_SLUG.

# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Milliseconds to drain in-flight requests on SIGTERM before forcing exit
# (index.js). Keep PM2 kill_timeout (ecosystem.config.js) above this.
SHUTDOWN_TIMEOUT_MS=10000

# ---- Observability (OpenObserve) ----
# utils/logger.js buffers logs and ships them to these streams: backend_logs,
# security_logs, audit_logs, access_logs, frontend_logs.
#
# Shipping is gated on the username/password below. Leave them empty and the
# logger writes to stdout and SILENTLY DROPS everything else — which in a
# container means production errors and the security log go nowhere. Set them,
# or accept that stdout is your only record and collect it some other way.
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_USERNAME=
OPENOBSERVE_PASSWORD=
LOG_LEVEL=info
# scripts/rotateLogs.js
LOG_RETENTION_DAYS=30
COMPRESS_LOGS=false

# Bearer token for GET /api/health/metrics. Unset = the route is open.
METRICS_TOKEN=

# ---- Multi-tenancy ----
# How a request is matched to a workspace. resolveTenant() tries, in order:
# the signed `tid` claim on the token, a custom domain, a subdomain, the
# x-tenant header, then the default below.
#
# APP_DOMAIN enables subdomain routing: acme.realvista.app resolves to the
# workspace with slug "acme". Leave empty for a single-workspace deployment.
APP_DOMAIN=

# The workspace a request falls back to when nothing else matches. Set this to
# the slug you migrated existing data into (scripts/migrateToMultiTenant.js
# prints it), or signed-out and pre-migration requests resolve to nothing.
DEFAULT_TENANT_SLUG=default

# ---- Database ----
# For local development: mongodb://127.0.0.1:27017/mern-estate
# For production: use MongoDB Atlas or your cloud provider
MONGO_URI=mongodb://127.0.0.1:27017/mern-estate
DB_MAX_POOL_SIZE=30
DB_MIN_POOL_SIZE=5
DB_MAX_IDLE_TIME_MS=60000
# How long a request waits for a free pooled connection before failing.
DB_WAIT_QUEUE_TIMEOUT_MS=10000
# Server-side time cap for any single find/aggregate in the API process (CLI
# scripts and migrations are exempt). 0 disables.
DB_MAX_TIME_MS=30000
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000

# ---- Authentication & JWT ----
# IMPORTANT: both secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
JWT_ISSUER=mern-estate-api
JWT_AUDIENCE=mern-estate-client
MAX_LOGIN_ATTEMPTS=5
# milliseconds (15 minutes)
LOCKOUT_DURATION=900000

# ---- Message encryption (REQUIRED) ----
# Encrypts chat messages and stored SMTP passwords. Set once and never rotate:
# rotating makes existing ciphertext unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENCRYPTION_KEY=

# Signs the unsubscribe links in automated follow-up emails (utils/unsubscribe.js).
# Set once and never rotate: rotating breaks every link already sent. Falls back
# to a key derived from JWT_SECRET when unset.
UNSUBSCRIBE_SECRET=

# ---- CORS ----
# Production CORS origins: FRONTEND_URL (+ ADMIN_URL). Must include the scheme,
# e.g. https://app.example.com. Also the base of links in invite/reset emails.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=
# Extra origins allowed outside production, comma-separated (e.g. the Flutter
# web dev port).
EXTRA_CORS_ORIGINS=

# ---- Rate limiting (defaults from config/environment.js) ----
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20
STRICT_RATE_LIMIT_MAX=30

# ---- Email (SMTP) ----
# Platform fallback transport; a workspace may configure its own. Port 465 uses
# implicit TLS, anything else STARTTLS. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# ---- SMS (Twilio, optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Public URLs ----
# Base URL used in links to a listing sent from chat / WhatsApp-style messages
# (server.js, message.controller.js). Falls back to a relative path when empty.
PUBLIC_BASE_URL=
# Only for a split deployment where the API is not on the same origin as the app:
# the public base URL a mail client's one-click unsubscribe POST should reach.
PUBLIC_API_URL=

# ---- Logging (see also Observability above) ----
# Requests slower than this (ms) are logged as warnings in backend_logs.
SLOW_REQUEST_MS=2000
# Database commands slower than this (ms) are logged; 0 turns it off.
SLOW_QUERY_MS=500
# Production writes JSON lines to stdout regardless; set json to get them in dev.
# LOG_FORMAT=json

# ---- Reverse proxy ----
# Number of proxies between the internet and this process (nginx, load balancer,
# CDN). Sets Express `trust proxy`, which decides req.ip and so every rate-limit
# bucket. Too low: all users share the proxy's IP. Too high: X-Forwarded-For can
# be spoofed. 0 disables. Applied in production, or whenever this is set.
TRUST_PROXY_HOPS=1

# ---- Response cache ----
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# ---- Multi-instance state (optional) ----
# Set this when running more than one instance: without it the response cache
# and the rate limiter are per-process, so caches diverge and every limit is
# multiplied by the number of instances. NOTE: Socket.IO presence is still
# in-process (no adapter installed), so keep the API at one instance for
# realtime unless you add @socket.io/redis-adapter.
REDIS_URL=

# Set to false on an instance that should serve traffic but run no scheduled
# jobs. Jobs take a lease in Mongo, so leaving it unset on every instance is
# safe — each job still runs once.
JOBS_ENABLED=

# ---- API response encryption (optional) ----
# When true, JSON bodies are wrapped as { _enc, iv, data } using
# API_RESPONSE_SECRET. The web client decrypts with VITE_API_RESPONSE_SECRET
# (same value). The mobile app identifies itself with `X-Client: mobile` and is
# always sent plaintext. Health endpoints are never encrypted.
ENCRYPT_API_RESPONSES=false
API_RESPONSE_SECRET=

# ---- Backups (scripts/backup.js, scripts/restore.js) ----
# Default: <repo>/backups
BACKUP_DIR=
BACKUP_RETENTION_COUNT=7
# restore.js refuses to run with NODE_ENV=production unless this is "true".
ALLOW_PRODUCTION_RESTORE=false

# ===========================================
# Push notifications (Android app, via Firebase Cloud Messaging)
# ===========================================
# Path to the Firebase service-account JSON (Project settings > Service accounts
# > Generate new private key). Keep the file outside the repo, readable only by
# the server user. Leave unset to switch push off.
FIREBASE_SERVICE_ACCOUNT_PATH=
