# EXAMPLE / UNVERIFIED. Nothing here has been run against nginx or deployed.
# Run `nginx -t` on the server before reloading. Adjust paths, server_name and
# certificate locations to the real host.
#
# Layout assumed (current single-EC2 setup): nginx terminates TLS, serves the
# built SPA from disk, and proxies the API to the Node process on 127.0.0.1:3000.
#
# Compression: gzip is below. Brotli needs the ngx_brotli module, which stock
# nginx packages do not include; if you build/install it, add
#   brotli on; brotli_comp_level 5; brotli_types <same list as gzip_types>;
# Otherwise leave it out. (CloudFront compresses for you in the later stages.)

# Websocket upgrade: "Connection: upgrade" only when the client asked.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream estate_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name realvista.example.com;     # PLACEHOLDER
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name realvista.example.com;     # PLACEHOLDER

    ssl_certificate     /etc/letsencrypt/live/realvista.example.com/fullchain.pem;  # PLACEHOLDER
    ssl_certificate_key /etc/letsencrypt/live/realvista.example.com/privkey.pem;    # PLACEHOLDER

    root /var/www/estate/frontend/dist;    # PLACEHOLDER: where `npm run build` output is copied
    index index.html;

    client_max_body_size 25m;              # match the largest upload the API accepts

    # ── Security headers ────────────────────────────────────────────────────
    # `always` so they are also sent on 4xx/5xx. The Express app (helmet) sets
    # its own CSP on API responses; add_header here applies to static files.
    # A strict Content-Security-Policy for the SPA is deliberately NOT set here:
    # derive it from what the bundle really loads (Cloudinary, map tiles,
    # fonts) and test with Content-Security-Policy-Report-Only first.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(self)" always;

    # ── Compression ─────────────────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript
               text/javascript application/xml image/svg+xml application/manifest+json;

    # ── Hashed build output: cache forever ──────────────────────────────────
    # Vite fingerprints filenames in /assets, so a changed file has a new URL.
    # NOTE: add_header inside a location REPLACES all server-level add_header
    # lines, so the security headers are repeated where it matters.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }
    location /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Never cache: entry points that reference the hashed files ───────────
    # A stale index.html or service worker pins users to an old bundle.
    location = /index.html { add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options "nosniff" always; }
    location = /sw.js { add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }
    location = /registerSW.js { add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }
    location ~ ^/workbox-[^/]+\.js$ { add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options "nosniff" always; try_files $uri =404; }
    location = /sitemap.xml { add_header Cache-Control "no-cache" always; try_files $uri =404; }
    location = /robots.txt  { add_header Cache-Control "no-cache" always; try_files $uri =404; }

    # ── API, uploads, realtime -> Node ──────────────────────────────────────
    # Real client IP: nginx is the first proxy, so $remote_addr IS the client.
    # Overwrite (not append to) X-Forwarded-For so a caller cannot spoof it:
    # with `trust proxy` = 1 in the app, Express uses the last entry.
    # Behind CloudFront + ALB (later stage) use $proxy_add_x_forwarded_for
    # instead and set TRUST_PROXY_HOPS=2 (see README.md).
    location /api/ {
        proxy_pass http://estate_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location /uploads/ {
        proxy_pass http://estate_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /socket.io/ {
        proxy_pass http://estate_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600s;          # idle websockets must not be cut at 60s
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ── Mobile app downloads: static, never the SPA shell ───────────────────
    # APK and latest.json are uploaded here by mobile/scripts/publish-apk.sh.
    location /app/ {
        alias /var/www/estate/app/;        # PLACEHOLDER
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── SPA fallback ────────────────────────────────────────────────────────
    # `$uri/` matters: the build writes real per-page HTML for /privacy,
    # /terms, /cookies, /refunds, /download (dist/<page>/index.html) that
    # crawlers must receive instead of the home page's tags.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ /index.html;
    }
}
